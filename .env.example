# Copy to .env and fill in. Never commit .env.
#
# LLM_PROVIDER selects the instruction-interpretation / orchestration backend:
#   none  -> deterministic fallback mode (default, no external API is called)
#   groq  -> Groq Chat Completions API (pip install groq; free tier available)
LLM_PROVIDER=none

# Model identifier passed verbatim to the provider (required when LLM_PROVIDER != none).
# It is recorded in every decision report for reproducibility.
# Groq models with tool calling (check availability): qwen/qwen3.8-27b, openai/gpt-oss-120b, openai/gpt-oss-20b
# (see https://console.groq.com/docs/models)
LLM_MODEL=

# Optional overrides of [agent] in config/default.toml.
LLM_TIMEOUT_S=
LLM_MAX_TOKENS=
# Optional reasoning-effort hint (sent only if set; only some Groq models accept it).
LLM_EFFORT=

# Groq credentials (https://console.groq.com/keys).
GROQ_API_KEY=

# Optional pricing used to *estimate* LLM inference cost in reports.
# Leave empty if unknown: cost is then reported as "unknown", never guessed.
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
