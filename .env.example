# Copy to .env and fill in. Never commit .env.
#
# LLM_PROVIDER selects the instruction-interpretation / orchestration backend:
#   none       -> deterministic fallback mode (default, no external API is called)
#   anthropic  -> Anthropic Messages API (pip install anthropic)
#   openai     -> any OpenAI-compatible Chat Completions endpoint (pip install openai)
LLM_PROVIDER=none

# Model identifier passed verbatim to the provider.
LLM_MODEL=

# Per-request timeout (seconds) and maximum output tokens.
LLM_TIMEOUT_S=30
LLM_MAX_TOKENS=1500

# Provider credentials (only the one matching LLM_PROVIDER is read).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional, for OpenAI-compatible servers (vLLM, Ollama, Mistral, Azure gateway, ...)
OPENAI_BASE_URL=

# Optional pricing used to *estimate* LLM inference cost in reports.
# Leave empty if unknown: cost is then reported as "unknown", never guessed.
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
